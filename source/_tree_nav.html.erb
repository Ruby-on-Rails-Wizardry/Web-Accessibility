<% node = current_tree_node %>
<% if node %>
<nav class="tree-nav" aria-label="On the knowledge tree">
  <p class="tree-nav__index"><%= link_to "Knowledge tree", "/learn/" %></p>

  <% spine = Array(node.spine) %>
  <% if spine.any? %>
    <h2>Trace</h2>
    <ol class="tree-nav__spine">
      <% spine.each do |id| %>
        <li<%= " class=\"is-current\"" if id.to_s == node.id.to_s %>>
          <% if id.to_s == node.id.to_s %>
            <%= tree_lookup(id)&.title || id %>
          <% else %>
            <%= tree_link(id) %>
          <% end %>
        </li>
      <% end %>
    </ol>
  <% end %>

  <% prereqs = Array(node.prereqs) %>
  <% if prereqs.any? %>
    <h2>Before this</h2>
    <ul>
      <% prereqs.each do |id| %>
        <li><%= tree_link(id) %></li>
      <% end %>
    </ul>
  <% end %>

  <% next_ids = tree_next_ids(node) %>
  <% if next_ids.any? %>
    <h2>Next on the tree</h2>
    <ul>
      <% next_ids.each do |id| %>
        <li><%= tree_link(id) %></li>
      <% end %>
    </ul>
  <% end %>

  <% example_ids = tree_example_ids(node) %>
  <% if example_ids.any? %>
    <h2>Check with tools</h2>
    <p>Open the live example alone so a heading list sees only that markup.</p>
    <ul>
      <% example_ids.each do |id| %>
        <li><%= link_to tree_lookup(id)&.title || id, tree_lookup(id)&.path || id, "data-turbo": "false" %></li>
      <% end %>
    </ul>
  <% end %>

  <% library = Array(node.library) %>
  <% if library.any? %>
    <h2>In the library</h2>
    <ul>
      <% library.each do |item| %>
        <li><%= link_to item.title, item.path %></li>
      <% end %>
    </ul>
  <% end %>
</nav>
<% end %>
