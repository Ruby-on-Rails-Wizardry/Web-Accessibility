<% node = current_tree_node %>
<% if node %>
<nav class="tree-nav" aria-label="On the knowledge tree">
  <h2>Where you are</h2>
  <ol class="docs-nav__crumbs">
    <li><%= link_to "Knowledge tree", "/learn/" %></li>
    <% Array(node.spine).each_with_index do |id, index| %>
      <% crumb = tree_lookup(id) %>
      <% current = id.to_s == node.id.to_s %>
      <li<%= " class=\"is-current\"" if current %> style="padding-left: <%= (index + 1) * 0.65 %>rem">
        <% if current || crumb.nil? %>
          <%= crumb&.title || id %>
        <% else %>
          <%= tree_link(id) %>
        <% end %>
      </li>
    <% end %>
  </ol>

  <% previous_id = tree_previous_id(node) %>
  <% following_id = tree_following_id(node) %>
  <% if previous_id || following_id %>
    <h2>On the tree</h2>
    <ul>
      <% if previous_id %>
        <li>Previous: <%= tree_link(previous_id) %></li>
      <% end %>
      <% if following_id %>
        <li>Next: <%= tree_link(following_id) %></li>
      <% end %>
    </ul>
  <% end %>

  <p class="tree-nav__index"><%= link_to "Testing tools", "/docs/evaluation/testing-tools/" %></p>

  <% library = Array(node.library) %>
  <% if library.any? %>
    <h2>In the library</h2>
    <ul>
      <% library.each do |item| %>
        <li><%= link_to item.title, item.path %></li>
      <% end %>
    </ul>
  <% end %>
</nav>
<% end %>
