<% parent = specimen_parent_node %>
<% other = specimen_other_node %>
<div class="specimen-banner">
  <p>
    <span class="specimen-banner__kind"><%= specimen_variant == "good" ? "Good example" : "Bad example" %></span>
    Live specimen of
    <% if parent %>
      <%= link_to parent.title, parent.path, "data-turbo": "false" %>.
    <% else %>
      the rule.
    <% end %>
    <%= current_page.data.specimen_note || (specimen_variant == "bad" ? "This page is supposed to fail a check of the rule." : "Check this page with the same tools.") %>
  </p>
  <p class="specimen-banner__links">
    <% if parent %>
      <%= link_to "The rule", parent.path, "data-turbo": "false" %>
    <% end %>
    <% if parent && other %>
      ·
    <% end %>
    <% if other %>
      <%= link_to (specimen_variant == "bad" ? "Good example" : "Bad example"), other.path, "data-turbo": "false" %>
    <% end %>
    <button
      type="button"
      class="button button--small specimen-banner__edit"
      data-specimen-target="toggle"
      data-action="specimen#toggle"
      aria-expanded="false"
      hidden
    >
      Edit
    </button>
  </p>
</div>
