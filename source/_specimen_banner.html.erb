<div class="specimen-banner">
  <div class="specimen-banner__text">
    <p class="specimen-banner__note">
      <span class="specimen-banner__kind"><%= specimen_variant == "good" ? "Good example" : "Bad example" %></span>
      <%= current_page.data.specimen_note || (specimen_variant == "bad" ? "This page is supposed to fail a heading-list check." : "Check this page with a heading list, WAVE, or axe.") %>
    </p>
    <%= partial "rule_scope" %>
  </div>
  <div class="specimen-banner__actions">
    <% if specimen_has_window? %>
      <%= link_to "Open example in a new window", "window/",
            class: "button button--small",
            target: "_blank",
            rel: "noopener noreferrer",
            "data-turbo": "false" %>
    <% else %>
      <button
        type="button"
        class="button button--small specimen-banner__edit"
        data-specimen-target="toggle"
        data-action="specimen#toggle"
        aria-expanded="false"
        hidden
      >
        Edit
      </button>
      <button
        type="button"
        class="button button--small specimen-banner__check"
        data-check-target="button"
        data-action="specimen#apply check#run"
        aria-controls="check-results"
        hidden
      >
        Check
      </button>
    <% end %>
  </div>
</div>
