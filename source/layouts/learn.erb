<% wrap_layout :layout do %>
  <article class="prose" data-controller="toc">
    <header class="prose__header">
      <h1><%= current_page.data.title %></h1>
      <% if current_page.data.description %>
        <p class="lede"><%= current_page.data.description %></p>
      <% end %>
      <% if current_page.data.rule %>
        <p class="rule-callout">
          <strong>The rule.</strong>
          <%= current_page.data.rule %>
        </p>
      <% end %>
    </header>
    <aside class="prose__aside">
      <%= partial "tree_nav" %>
      <nav class="toc" aria-label="On this page">
        <h2>On this page</h2>
        <ol data-toc-target="list"></ol>
      </nav>
    </aside>
    <div class="prose__body">
      <%= yield %>
    </div>
  </article>
<% end %>
