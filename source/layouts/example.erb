<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="<%= page_description %>">
    <meta name="turbo-visit-control" content="reload">
    <title><%= page_title %></title>
    <style>:root { --accent: <%= accent_color %>; }</style>
    <%= stylesheet_link_tag "site", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "site", type: "module", "data-turbo-track": "reload" %>
    <link rel="icon" href="<%= image_path('mark.jpg') %>" type="image/jpeg">
  </head>
  <body class="specimen specimen--<%= specimen_variant %>" data-controller="specimen">
    <%= partial "skip_link" %>
    <%= partial "header" %>
    <%= partial "specimen_banner" %>
    <main id="main" class="specimen-main" data-specimen-target="stage">
      <%= yield %>
    </main>
  </body>
</html>
