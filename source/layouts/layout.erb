<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="<%= page_description %>">
    <title><%= page_title %></title>
    <style>:root { --accent: <%= accent_color %>; }</style>
    <%= stylesheet_link_tag "site", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "site", type: "module", "data-turbo-track": "reload" %>
    <link rel="icon" href="<%= image_path('favicon.svg') %>" type="image/svg+xml">
  </head>
  <body>
    <%= partial "skip_link" %>
    <%= partial "header" %>
    <main id="main">
      <%= yield %>
    </main>
    <%= partial "footer" %>
  </body>
</html>
