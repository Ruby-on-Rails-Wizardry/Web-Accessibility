<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="<%= page_description %>">
    <meta name="turbo-visit-control" content="reload">
    <title><%= page_title %></title>
    <style>:root { --accent: <%= accent_color %>; }</style>
    <%= stylesheet_link_tag "site", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "site", type: "module", "data-turbo-track": "reload" %>
    <link rel="icon" href="<%= image_path('mark.jpg') %>" type="image/jpeg">
  </head>
  <body
    class="practice practice--<%= practice_variant %>"
    data-controller="check"
    data-check-catalog-value="<%= CGI.escapeHTML(check_catalog.to_json) %>"
  >
    <%= partial "skip_link" %>
    <%= partial "header" %>
    <% page_body = yield %>
    <div class="specimen-shell">
      <div class="specimen-primary">
        <%= partial "practice_banner" %>
        <% if practice_variant == "fix" %>
          <div class="practice-card">
            <div class="specimen-editor">
              <div class="specimen-editor__inner">
                <label class="practice-caption" for="specimen-source">HTML</label>
                <textarea
                  id="specimen-source"
                  data-check-target="source"
                  data-action="keydown->check#keydown"
                  rows="8"
                  spellcheck="false"
                  autocapitalize="off"
                  autocomplete="off"
                ><%= CGI.escapeHTML(page_body.to_s.strip) %></textarea>
                <p class="specimen-editor__actions">
                  <button type="button" class="button button--small" data-action="check#applyAndCheck">Apply</button>
                  <button type="button" class="button button--small button--ghost" data-action="check#reset">Reset</button>
                  <button type="button" class="button button--small button--ghost" data-action="check#another" data-check-target="another" hidden>Another example</button>
                </p>
              </div>
            </div>
            <div
              class="check-results"
              id="check-results"
              data-check-target="results"
              tabindex="-1"
              aria-live="polite"
            ></div>
            <p class="practice-caption">Rendered</p>
            <div class="practice-preview">
              <main id="main" class="specimen-main" data-check-target="section">
                <%= page_body.html_safe %>
              </main>
            </div>
          </div>
        <% else %>
          <div
            class="check-results"
            id="check-results"
            data-check-target="results"
            tabindex="-1"
            aria-live="polite"
          ></div>
          <main id="main" class="specimen-main">
            <%= page_body.html_safe %>
          </main>
        <% end %>
      </div>
      <aside class="specimen-aside">
        <%= partial "practice_nav" %>
      </aside>
    </div>
  </body>
</html>
