<header class="site-header" data-controller="nav">
  <div class="site-header__inner">
    <%= link_to site.title, "/",
          class: ["site-title", (nav_current?("/") ? "is-current" : nil)].compact.join(" "),
          "aria-current": (nav_current?("/") ? "page" : nil) %>

    <button
      type="button"
      class="site-nav__toggle"
      data-nav-target="button"
      data-action="nav#toggle"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      Menu
    </button>

    <nav id="site-nav" class="site-nav" data-nav-target="menu" aria-label="Primary">
      <ul>
        <% nav_items.each do |item| %>
          <li>
            <%= link_to item.title, item.path,
                  class: nav_current?(item.path) ? "is-current" : nil,
                  "aria-current": (nav_current?(item.path) ? "page" : nil) %>
          </li>
        <% end %>
        <% if site.repo.to_s.strip != "" %>
          <li><%= link_to "Source", site.repo, target: "_blank", rel: "noopener" %></li>
        <% end %>
      </ul>
    </nav>

    <a
      href="<%= org_home %>"
      class="site-org"
      title="Ruby on Rails Wizardry"
      aria-label="Ruby on Rails Wizardry"
    >
      <img src="<%= image_path('mark.jpg') %>" width="40" height="40" alt="">
    </a>
  </div>
</header>
