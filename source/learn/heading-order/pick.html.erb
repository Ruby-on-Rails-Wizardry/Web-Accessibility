---
title: Pick the example that follows the rule
description: Two live examples. Pick the one that nests heading levels.
node: heading-order-pick
layout: practice
practice: pick
of: heading-order
check_rules:
  - heading-order
practice_note: Each card shows the HTML and how it renders. Pick the one that nests headings in order.
---
<%
  examples = [
    "<h1>Permits</h1>\n<h4>Residential</h4>\n<h4>Commercial</h4>",
    "<h1>Permits</h1>\n<h2>Residential</h2>\n<h2>Commercial</h2>"
  ]
%>
<fieldset class="practice-choices">
  <legend class="practice-choices__legend">Examples</legend>
  <div class="practice-choices__grid">
    <% examples.each_with_index do |html, index| %>
      <% letter = ("A".ord + index).chr %>
      <label class="practice-choice">
        <input type="radio" name="practice-pick" data-check-target="choice" data-action="change->check#run" aria-label="Example <%= letter %>">
        <span class="practice-choice__name">Example <%= letter %></span>
        <span class="practice-caption">HTML</span>
        <pre class="practice-choice__source"><code><%= CGI.escapeHTML(html) %></code></pre>
        <span class="practice-caption">Rendered</span>
        <div class="practice-preview" data-check-target="section">
          <%= html.html_safe %>
        </div>
      </label>
    <% end %>
  </div>
</fieldset>
